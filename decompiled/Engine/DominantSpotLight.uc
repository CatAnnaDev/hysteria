    Components(3)="Default__DominantSpotLight.DrawOuterCone0"
    Components(4)="Default__DominantSpotLight.DrawLightSourceRadius0"
    Components(5)="Default__DominantSpotLight.ArrowComponent0"
    Components(6)="Default__DominantSpotLight.DominantSpotLightComponent0"
}

class UIComp_DrawCaption extends UIComp_DrawString
    native
    notplaceable
    editinlinenew
    within UIObject
    hidecategories(Object);

defaultproperties
{
    StyleResolverTag="Caption Style"
    bAllowBoundsAdjustment=False
    TextStyleCustomization=(ClipMode="CLIP_Normal",bOverrideClipMode=True)
}
